# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# GITHUB_TOKEN: Optional personal access token for private repos and higher GitHub REST API rate limits.
GITHUB_TOKEN=

# VERCEL_TOKEN: Optional Vercel API token for fetching live deployment status from Vercel.
VERCEL_TOKEN=

# VERCEL_TEAM_ID: Optional Vercel Team ID if the project belongs to a team.
VERCEL_TEAM_ID=

# SQLITE_DB_PATH: Optional custom filesystem path for the SQLite database file.
SQLITE_DB_PATH=
